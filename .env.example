# Server only. Never use NEXT_PUBLIC_ for these values.
# Leave blank for local UI development and no-spend checks.
DATABASE_URL=
WEFT_API_KEY=
CRON_SECRET=

# Durable enrichment is opt-in after explicit migrations and policy review.
# A buyer key alone no longer enables unarchived paid collection.
ENRICHMENT_DATABASE_URL=
ENRICHMENT_ALLOW_PAID=0
ENRICHMENT_CAPTURE_CONFIG=

# Optional public PostHog project token (phc_...). Not a personal API key.
# Use a Founders Directory project. Do not reuse another product's token.
# Blank = analytics stays off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
