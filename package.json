{
  "name": "founder-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --import ./tests/no-network.mjs --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:repo"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neondatabase/serverless": "1.0.2",
    "@weft-labs/sdk": "0.20.0",
    "@x402/core": "2.20.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.2",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.14.0 <23"
  }
}
